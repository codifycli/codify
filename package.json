{
  "author": "kevinwang @kevinwang5658",
  "bin": {
    "codify": "./bin/run.js"
  },
  "dependencies": {
    "@assistant-ui/ai-sdk": "^0.0.18",
    "@assistant-ui/react-ink": "^0.0.54",
    "@codifycli/schemas": "1.6.0",
    "@mischnic/json-sourcemap": "^0.1.1",
    "@oclif/core": "^4.0.8",
    "@oclif/plugin-autocomplete": "^3.2.24",
    "@oclif/plugin-help": "^6.2.4",
    "ai": "^7.0.174",
    "ajv": "^8.12.0",
    "chalk": "^5.3.0",
    "diff": "^8.0.3",
    "ink": "^8.0.0",
    "jju": "^1.4.0",
    "jose": "^6.1.0",
    "js-yaml": "^4.1.0",
    "js-yaml-source-map": "^0.2.2",
    "json-source-map": "^0.6.1",
    "node-pty": "1.2.0-beta.15",
    "react": "~19.3.0",
    "undici": "^7.30.2",
    "ws": "^8.18.3"
  },
  "description": "Codify is a configuration-as-code tool that declaratively installs and manages developer tools and applications. Check out https://dashboard.codifycli.com for an editor.",
  "devDependencies": {
    "@codifycli/plugin-core": "^1.3.0",
    "@oclif/prettier-config": "^0.2.1",
    "@types/jju": "^1.4.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@xterm/headless": "^5.5.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "eslint-config-oclif": "^7.1.10",
    "eslint-config-prettier": "^10.1.8",
    "memfs": "^4.14.0",
    "oclif": "^6.0.10",
    "tsx": "^4.7.3",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "eslint-config-xo": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json",
    "/shims"
  ],
  "homepage": "https://github.com/codifycli/codify",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "name": "codify",
  "type": "module",
  "oclif": {
    "bin": "codify",
    "dirname": "codify",
    "commands": "./dist/commands",
    "hooks": {
      "init": "./dist/hooks/init"
    },
    "helpClass": "./dist/help",
    "additionalVersionFlags": [
      "-v"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "defaultCommand": "edit",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ],
    "topicSeparator": " ",
    "topics": {},
    "macos": {
      "identifier": "com.codify.cli",
      "sign": "\"Developer ID Installer: Qingran Wang (PCG246DPVT)\"",
      "application-certificate": "Developer ID Application: Qingran Wang (PCG246DPVT)"
    },
    "update": {
      "s3": {
        "host": "https://releases.codifycli.com",
        "bucket": "cli-releases-v2"
      }
    }
  },
  "repository": "codifycli/codify",
  "scripts": {
    "postinstall": "[ -f node_modules/oclif/lib/tarballs/bin.js ] && tsx scripts/patch-oclif.ts || true",
    "build": "rm -rf dist && tsc -b",
    "build:release": "npm run pkg && ./scripts/notarize.sh",
    "lint": "tsc",
    "postpack": "rm -f oclif.manifest.json",
    "pretarball": "../../../scripts/pretarball.sh",
    "pkg": "tsx ./scripts/pkg.ts",
    "notarize": "./scripts/notarize.sh",
    "upload": "./scripts/upload.sh",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest",
    "lint:eslint": "eslint src",
    "version": "oclif readme && git add README.md",
    "start:dev": "./bin/dev.js",
    "start:dev:beta": "CODIFY_BETA=1 ./bin/dev.js",
    "start:vm": "npm run build && npm run pack:macos && npm run start:vm",
    "deploy": "npm run pkg && npm run notarize && npm run upload",
    "build:npm": "tsx ./scripts/build-npm.ts",
    "restore-npm": "tsx ./scripts/restore-npm.ts",
    "prepublishOnly": "npm run build && npm run build:npm",
    "postpublish": "npm run restore-npm"
  },
  "version": "1.3.0",
  "bugs": "https://github.com/codifycli/codify/issues",
  "keywords": [
    "oclif",
    "codify",
    "automated-installation",
    "system-automation",
    "configuration-as-code",
    "system-configuration"
  ],
  "types": "dist/index.d.ts"
}
