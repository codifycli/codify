// ### Basic website starter
//
// Pick the kind of site you want and get a popular, well-maintained starter
// cloned to your machine with the tooling it needs already installed.
//
// - **portfolio**: RyanFitzgerald/devportfolio (Astro, npm)
// - **resume**: BartoszJarocki/cv (Next.js, pnpm)
// - **blog**: satnaing/astro-paper (Astro, pnpm)
// - **docs**: mintlify/starter (Mintlify, mint CLI)
// - **landing-page**: onwidget/astrowind (Astro + Tailwind, npm)
//
// Repositories are cloned over HTTPS, so no GitHub SSH key is needed.
[
  {
    "type": "variable",
    "name": "siteType",
    "valueType": "enum",
    "label": "What kind of website are you building?",
    "description": "Each choice clones a popular starter repo and installs the tools it needs.",
    "options": ["portfolio", "resume", "blog", "docs", "landing-page"],
    "default": "portfolio"
  },
  {
    "type": "variable",
    "name": "projectDirectory",
    "label": "Where should the project be created?",
    "description": "The starter is cloned into this folder.",
    "default": "~/projects/my-website"
  },

  // ### Tooling

  // Node 24 LTS. The Astro and Next.js starters all need Node 22+.
  {
    "type": "nvm",
    "nodeVersions": ["24"],
    "global": "24"
  },
  // pnpm for the starters that ship a pnpm lockfile
  {
    "type": "pnpm",
    "when": { "siteType": ["resume", "blog"] },
    "dependsOn": ["nvm"]
  },
  // Mintlify CLI to preview the docs site locally (`mint dev`)
  {
    "type": "npm",
    "globalInstall": ["mint"],
    "when": { "siteType": "docs" },
    "dependsOn": ["nvm"]
  },

  // ### Starter repositories
  // Only the repository for the chosen site type is cloned.
  {
    "type": "git-repository",
    "name": "portfolio",
    "repository": "https://github.com/RyanFitzgerald/devportfolio.git",
    "directory": "${{ projectDirectory }}",
    "when": { "siteType": "portfolio" }
  },
  {
    "type": "git-repository",
    "name": "resume",
    "repository": "https://github.com/BartoszJarocki/cv.git",
    "directory": "${{ projectDirectory }}",
    "when": { "siteType": "resume" }
  },
  {
    "type": "git-repository",
    "name": "blog",
    "repository": "https://github.com/satnaing/astro-paper.git",
    "directory": "${{ projectDirectory }}",
    "when": { "siteType": "blog" }
  },
  {
    "type": "git-repository",
    "name": "docs",
    "repository": "https://github.com/mintlify/starter.git",
    "directory": "${{ projectDirectory }}",
    "when": { "siteType": "docs" }
  },
  {
    "type": "git-repository",
    "name": "landing-page",
    "repository": "https://github.com/onwidget/astrowind.git",
    "directory": "${{ projectDirectory }}",
    "when": { "siteType": "landing-page" }
  },

  // ### Project dependencies
  // Detects npm or pnpm from the starter's lockfile. The Mintlify docs
  // starter has no dependencies to install.
  {
    "type": "project-install",
    "directory": "${{ projectDirectory }}",
    "when": { "siteType": { "not": "docs" } },
    "dependsOn": [
      "nvm",
      "pnpm",
      "git-repository.portfolio",
      "git-repository.resume",
      "git-repository.blog",
      "git-repository.landing-page"
    ]
  },

  // ### Getting started
  // Shown once Codify has finished installing.
  {
    "type": "notice",
    "name": "portfolio-ready",
    "level": "success",
    "title": "Your portfolio site is ready",
    "message": "Node 24 and the Astro portfolio starter are installed in `${{ projectDirectory }}`.\n\nStart it:\n  `cd ${{ projectDirectory }} && npm run dev`\nThen open http://localhost:4321\n\nAdd your name, projects and experience in `src/config.ts`.\nOpen a new terminal first if `npm` isn't found yet.",
    "when": { "siteType": "portfolio" }
  },
  {
    "type": "notice",
    "name": "resume-ready",
    "level": "success",
    "title": "Your resume site is ready",
    "message": "Node 24, pnpm and the Next.js resume starter are installed in `${{ projectDirectory }}`.\n\nStart it:\n  `cd ${{ projectDirectory }} && pnpm dev`\nThen open http://localhost:3000\n\nEdit your resume in `src/data/resume-data.ts`.\nOpen a new terminal first if `pnpm` isn't found yet.",
    "when": { "siteType": "resume" }
  },
  {
    "type": "notice",
    "name": "blog-ready",
    "level": "success",
    "title": "Your blog is ready",
    "message": "Node 24, pnpm and the AstroPaper blog starter are installed in `${{ projectDirectory }}`.\n\nStart it:\n  `cd ${{ projectDirectory }} && pnpm dev`\nThen open http://localhost:4321\n\nSet your site details in `src/config.ts` and write posts in `src/content/posts/`.\nOpen a new terminal first if `pnpm` isn't found yet.",
    "when": { "siteType": "blog" }
  },
  {
    "type": "notice",
    "name": "docs-ready",
    "level": "success",
    "title": "Your docs site is ready",
    "message": "Node 24, the Mintlify CLI and the Mintlify docs starter are installed in `${{ projectDirectory }}`.\n\nStart it:\n  `cd ${{ projectDirectory }} && mint dev`\nThen open http://localhost:3000\n\nEdit pages in the `.mdx` files and the navigation in `docs.json`.\nOpen a new terminal first if `mint` isn't found yet.",
    "when": { "siteType": "docs" }
  },
  {
    "type": "notice",
    "name": "landing-page-ready",
    "level": "success",
    "title": "Your landing page is ready",
    "message": "Node 24 and the AstroWind landing page starter are installed in `${{ projectDirectory }}`.\n\nStart it:\n  `cd ${{ projectDirectory }} && npm run dev`\nThen open http://localhost:4321\n\nSet your site details in `src/config.yaml` and edit pages in `src/pages/`.\nOpen a new terminal first if `npm` isn't found yet.",
    "when": { "siteType": "landing-page" }
  }
]
